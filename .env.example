# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# See README "구글 로그인 설정" for the exact steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these emails may ever sign in — this is the actual access control,
# not the Google login itself. Comma-separated, no spaces needed.
ALLOWED_EMAILS=mom@example.com,me@example.com

# Random secret next-auth uses to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Local dev: http://localhost:3000 — after deploying, set this to your real
# https://your-app.vercel.app URL (see README "배포하기").
NEXTAUTH_URL=http://localhost:3000

# Only needed in production (Vercel) — leave empty for local dev, where
# per-user data falls back to a local .data/ folder automatically.
BLOB_READ_WRITE_TOKEN=
